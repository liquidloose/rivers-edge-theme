			"palette": [
				{
					"color": "#FFFFFF",
					"name": "Base Background",
					"slug": "base"
				},
				{
					"color": "#b0c0c8",
					"name": "UI Borders & Dividers",
					"slug": "contrast"
				},
				{
					"color": "#3B8AC5",
					"name": "Secondary Actions & Links",
					"slug": "accent-1"
				},
				{
					"color": "#123A65",
					"name": "Primary Text & Dark Base",
					"slug": "accent-2"
				},
				{
					"color": "#e87c4c",
					"name": "Primary Call To Action",
					"slug": "accent-3"
				},
				{
					"color": "#7cd8e0",
					"name": "Status Badges & Info Pill",
					"slug": "accent-4"
				},
				{
					"color": "#000000",
					"name": "Black",
					"slug": "accent-5"
