					"slug": "accent-6"
				}
			]
		},
		"layout": {
			"contentSize": "1400px",
			"wideSize": "100vw"
		},
		"spacing": {
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
